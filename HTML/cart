<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width-device-width, initial-scale=1.0">
        <link rel="stylesheet" href="../CSS/theme.css">
        <link rel="stylesheet" href="../CSS/cart.css">
        <link rel="stylesheet" href="../CSS/darkmode.css">
        <title>Shopping Cart</title>
    </head> 

   <!-- Navigation Section-->
    <body>
        <header>
          <nav class="navigation_bar">

              <div class="nav-left">

                    <a href="../HTML/menu.html" class="nav_fonts hover-underline"> Our Products </a>
                    <a href="../HTML/about_us.html" class="nav_fonts hover-underline"> About Us </a>
              </div>

              <div class="nav-center">

                    <a href="../HTML/index.html" class="logo"><img src="../Assets/Images/logo.png" alt="SUNBAKE"></a>

              </div>

                <div class="nav-right">
                    <a href="#" id="account" aria-label="User Account">
                        <img src="../Assets/Images/account.png" class="icons" alt="Account">
                    </a>
                
                      <button
                          type="button"
                          id="themeToggle"
                          class="theme-toggle"
                          aria-label="Switch to dark mode"
                          title="Switch colour theme">☾
                      </button>

                </div>

            </nav>

</header>

 <!-- Cart Main Page -->
<section class="cart-page">

    <h1>Shopping Cart</h1>

    <div class="cart-container">

        <div class="cart-items">
            <div id="cartList"></div>
        </div>

        <div class="cart-summary">

            <h2>Order Summary</h2>

            <div class= "summary-row">
                <span>Items</span>
                <span id="itemCount">0</span>
            </div>

            <div class= "summary-row">
                <span>Total</span>
                <span id="totalPrice">RM 0.00</span>
            </div>

            <button id= "checkoutBtn">
                Checkout
            </button>

        </div>

    </div>

</section>


 <!-- Footer -->
<footer>
      <hr class="divider">
      <div class="footer_container">
        <div class="footer_left">
          <h2>To get to know us</h2>

          <br>

          <!-- left side (subscribe) -->
          <h4>Freshly Baked Content delivered straight to your inbox</h4>
          <p>Get the latest updates and exclusive access to everything we’re baking up</p>

          <br>

          <form id="subscribeForm" class="input-bar">
            <input type="email" id="subscribeInput" name="email" class="input-bar" placeholder="Enter your email" required>
            <button type="submit" class="subscribe-btn" aria-label="Subscribe">&#8594;</button>
          </form>

          <!-- success message (Hidden by default) -->
          <div id="subscribeSuccess" class="subscribe-success hidden">
            <p class="success-text">&#10003; THANKS FOR SUBSCRIBING</p>
          </div>

        </div>

          <!-- right side (customer service) -->
        <div class="footer_right">
          <div class="contact-form-container">
            <h3>Contact Us</h3>
            <form action="#" method="POST" class="contact-form" id="contactForm">
              <div class="form-row">
                <div class="form-group">
                  <label for="contact-name">Username / Name</label>
                  <input type="text" id="contact-name" name="name" placeholder="Your Name" required>
                </div>
                <div class="form-group">
                  <label for="contact-email">Email Address</label>
                  <input type="email" id="contact-email" name="email" placeholder="name@domain.com" required>
                </div>
              </div>
              <div class="form-group">
                <label for="contact-message">Questions / Inquiries</label>
                <textarea id="contact-message" name="message" placeholder="Ask us anything about our cakes..." rows="4" required></textarea>
              </div>
              <button type="submit" class="submit-btn">Send Message</button>
            </form>

            <!-- success message (Hidden by default) -->
            <div id="contactSuccess" class="contact-success hidden">
                <p class="success-text">&#10003; THANKS FOR REACHING OUT!</p>
            </div>
          </div>
        </div>
      </div>
      <p class="copyright">&copy; 2026 SUNBAKE Bakers. SUNBAKE Manufactory Sdn Bhd.</p>
    </footer>

    <script src="../JS/website.js"></script>
    <script src="../JS/cart.js"></script>
    </body>
</html>
